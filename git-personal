#!/usr/bin/env bash
# git-personal — configure the current (or given) git repo to use the personal
# GitHub identity instead of the global/Dexian one.
#
# Usage:
#   git-personal                 # apply to the repo in the current directory
#   git-personal <path>          # apply to the repo at <path>
#   git-personal --global        # set personal identity globally (override default)
#
# Idempotent: safe to run more than once.

set -euo pipefail

# ---- personal identity (edit these if they ever change) ---------------------
PERSONAL_NAME="Nipu"
PERSONAL_EMAIL="88454052+Notmeher@users.noreply.github.com"
PERSONAL_GH_USER="Notmeher"
# -----------------------------------------------------------------------------

color() { printf "\033[%sm%s\033[0m\n" "$1" "$2"; }
info()  { color "1;34" "▸ $*"; }
ok()    { color "1;32" "✓ $*"; }
warn()  { color "1;33" "! $*"; }
err()   { color "1;31" "✗ $*" >&2; }

SCOPE="--local"
TARGET_DIR="."

# ---- parse args -------------------------------------------------------------
for arg in "$@"; do
  case "$arg" in
    --global) SCOPE="--global" ;;
    -h|--help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) TARGET_DIR="$arg" ;;
  esac
done

# ---- repo check -------------------------------------------------------------
if [[ "$SCOPE" == "--local" ]]; then
  if [[ ! -d "$TARGET_DIR" ]]; then
    err "Directory not found: $TARGET_DIR"; exit 1
  fi
  cd "$TARGET_DIR"
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    err "Not a git repository: $(pwd)"
    err "Run inside a repo, or pass --global to set the identity globally."
    exit 1
  fi
  info "Configuring repo: $(git rev-parse --show-toplevel)"
else
  info "Configuring GLOBAL git identity"
fi

# ---- set identity -----------------------------------------------------------
git config "$SCOPE" user.name  "$PERSONAL_NAME"
git config "$SCOPE" user.email "$PERSONAL_EMAIL"
ok "user.name  = $(git config "$SCOPE" user.name)"
ok "user.email = $(git config "$SCOPE" user.email)"

# ---- gh CLI: make sure the personal account is the active one ---------------
if command -v gh >/dev/null 2>&1; then
  ACTIVE_USER="$(gh api user --jq .login 2>/dev/null || true)"
  if [[ -z "$ACTIVE_USER" ]]; then
    warn "gh is installed but not authenticated. Run: gh auth login --web"
  elif [[ "$ACTIVE_USER" != "$PERSONAL_GH_USER" ]]; then
    warn "gh is currently signed in as '$ACTIVE_USER' (expected '$PERSONAL_GH_USER')."
    warn "Switch with:  gh auth switch --user $PERSONAL_GH_USER"
  else
    ok "gh CLI active account: $ACTIVE_USER"
  fi
else
  warn "gh CLI not installed (install with: brew install gh)"
fi

# ---- show remote (if any) ---------------------------------------------------
if [[ "$SCOPE" == "--local" ]]; then
  REMOTE_URL="$(git remote get-url origin 2>/dev/null || true)"
  [[ -n "$REMOTE_URL" ]] && info "origin: $REMOTE_URL"
fi

ok "Done."
